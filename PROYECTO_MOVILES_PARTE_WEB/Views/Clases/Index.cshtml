@model List<PROYECTO_MOVILES_PARTE_WEB.Models.Clase>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Clases de Academia";
    var rol = HttpContextAccessor.HttpContext?.Session.GetString("Rol") ?? "";
    var esProfesor = rol == "Profesor" || rol == "Entrenador";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-mortarboard-fill text-warning me-2"></i> Clases de Academia</h3>
            <p class="text-muted mb-0">Programación de sesiones de entrenamiento, profesores y canchas asignadas</p>
        </div>
        @if (!esProfesor)
        {
            <a asp-action="Crear" class="btn btn-warning text-dark fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Programar Clase
            </a>
        }
    </div>

    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Profesor</th>
                        <th>Cancha</th>
                        <th>Fecha de Clase</th>
                        <th>Horario</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No hay clases programadas actualmente.
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@c.IdClase</td>
                            <td class="fw-semibold">
                                <i class="bi bi-person-badge text-success me-1"></i> @c.NombreProfesor
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@c.NombreCancha</span>
                            </td>
                            <td>@c.FechaClase.ToString("dd/MM/yyyy")</td>
                            <td>@c.HoraInicio.ToString("HH:mm") - @c.HoraFin.ToString("HH:mm")</td>
                            <td>
                                @if (c.EstadoClase == "Programada")
                                {
                                    <span class="badge bg-warning text-dark">Programada</span>
                                }
                                else if (c.EstadoClase == "En curso")
                                {
                                    <span class="badge bg-primary">En curso</span>
                                }
                                else if (c.EstadoClase == "Completada")
                                {
                                    <span class="badge bg-success">Completada</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelada</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <a asp-action="Asistencia" asp-route-id="@c.IdClase" class="btn btn-sm btn-outline-success" title="Pasar Asistencia (RN02)">
                                        <i class="bi bi-clipboard-check me-1"></i> Asistencia
                                    </a>
                                    @if (!esProfesor)
                                    {
                                        <a asp-action="Editar" asp-route-id="@c.IdClase" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (c.EstadoClase != "Cancelada" && c.EstadoClase != "Completada")
                                        {
                                            <form asp-action="Cancelar" asp-route-id="@c.IdClase" method="post" class="d-inline" onsubmit="return confirm('¿Deseas cancelar esta sesión de clase?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
