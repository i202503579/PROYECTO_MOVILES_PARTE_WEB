@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var usuarioLogueado = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioLogueado") ?? "Seichi";
    var rol = HttpContextAccessor.HttpContext?.Session.GetString("Rol") ?? "Administrador";
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Canchitas Club Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Verde (Mockup) -->
        <aside class="sidebar">
            <a asp-controller="@(rol == "Profesor" || rol == "Entrenador" ? "Clases" : "Home")" asp-action="Index" class="sidebar-brand">
                <i class="bi bi-dribbble"></i>
                <span>Canchitas Club</span>
            </a>

            @if (rol == "Administrador" || rol == "Operador")
            {
                <div class="sidebar-section-title">PANEL</div>
                <ul class="sidebar-nav">
                    <li class="@(controllerActual == "Home" ? "active" : "")">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Analíticas</span>
                        </a>
                    </li>
                </ul>
            }

            <div class="sidebar-section-title">@(rol == "Profesor" || rol == "Entrenador" ? "MI ACADEMIA" : "LISTADO Y GESTIÓN")</div>
            <ul class="sidebar-nav">
                @if (rol == "Administrador" || rol == "Operador")
                {
                    <li class="@(controllerActual == "Reservas" ? "active" : "")">
                        <a asp-controller="Reservas" asp-action="Index">
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>Alquileres (Reservas)</span>
                        </a>
                    </li>
                }

                @if (rol == "Administrador" || rol == "Profesor" || rol == "Entrenador")
                {
                    <li class="@(controllerActual == "Clases" ? "active" : "")">
                        <a asp-controller="Clases" asp-action="Index">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Clases y Asistencia</span>
                        </a>
                    </li>
                }

                @if (rol == "Administrador")
                {
                    <li class="@(controllerActual == "Canchas" ? "active" : "")">
                        <a asp-controller="Canchas" asp-action="Index">
                            <i class="bi bi-layers-fill"></i>
                            <span>Canchitas y Tarifas</span>
                        </a>
                    </li>
                }

                @if (rol == "Administrador" || rol == "Operador")
                {
                    <li class="@(controllerActual == "Clientes" ? "active" : "")">
                        <a asp-controller="Clientes" asp-action="Index">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Clientes</span>
                        </a>
                    </li>
                }

                @if (rol == "Administrador" || rol == "Profesor" || rol == "Entrenador")
                {
                    <li class="@(controllerActual == "Alumnos" ? "active" : "")">
                        <a asp-controller="Alumnos" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>Alumnos</span>
                        </a>
                    </li>
                }

                @if (rol == "Administrador")
                {
                    <li class="@(controllerActual == "Usuarios" ? "active" : "")">
                        <a asp-controller="Usuarios" asp-action="Index">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Usuarios y Roles</span>
                        </a>
                    </li>
                }

                @if (rol == "Administrador" || rol == "Operador")
                {
                    <li class="@(controllerActual == "Prestamos" ? "active" : "")">
                        <a asp-controller="Prestamos" asp-action="Index">
                            <i class="bi bi-trophy-fill"></i>
                            <span>Préstamo de Balón</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Navbar -->
            <header class="top-navbar">
                @if (rol == "Profesor" || rol == "Entrenador")
                {
                    <a asp-controller="Clases" asp-action="Index" class="notif-badge text-decoration-none text-secondary" title="Mis Clases Asignadas">
                        <div class="position-relative d-inline-block">
                            <i class="bi bi-mortarboard-fill fs-5 text-warning"></i>
                        </div>
                        <span class="text-muted d-none d-md-inline ms-1" style="font-size: 0.85rem;">Mis Clases</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Reservas" asp-action="Index" class="notif-badge text-decoration-none text-secondary" title="Ir a Alquileres y Reservas">
                        <div class="position-relative d-inline-block">
                            <i class="bi bi-bell-fill fs-5 text-secondary"></i>
                            <span class="badge-count">●</span>
                        </div>
                        <span class="text-muted d-none d-md-inline ms-1" style="font-size: 0.85rem;">Alquileres Activos</span>
                    </a>
                }

                <div class="dropdown">
                    <div class="user-profile dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">
                            @(usuarioLogueado.Length > 0 ? usuarioLogueado.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="d-none d-sm-block text-start">
                            <div class="fw-bold" style="font-size: 0.9rem;">@usuarioLogueado</div>
                            <small class="text-muted" style="font-size: 0.75rem;">@rol</small>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li>
                            <a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </header>

            <!-- Body -->
            <main class="page-body">
                @if (TempData["Exito"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
