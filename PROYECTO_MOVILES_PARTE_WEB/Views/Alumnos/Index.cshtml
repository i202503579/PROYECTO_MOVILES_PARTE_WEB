@model List<PROYECTO_MOVILES_PARTE_WEB.Models.Alumno>
@{
    ViewData["Title"] = "Gestión de Alumnos";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-people-fill text-success me-2"></i> Alumnos de Academia</h3>
            <p class="text-muted mb-0">Matrícula de alumnos, datos de apoderados y profesor asignado</p>
        </div>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i> Matricular Alumno
        </a>
    </div>

    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nombre del Alumno</th>
                        <th>Teléfono Apoderado</th>
                        <th>Fecha Ingreso</th>
                        <th>Profesor Asignado</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No hay alumnos matriculados.
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@a.IdAlumno</td>
                            <td class="fw-semibold">@a.NombreAlumno</td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.TelefonoApoderado))
                                {
                                    <a href="tel:@a.TelefonoApoderado" class="text-decoration-none text-dark">
                                        <i class="bi bi-telephone text-success me-1"></i> @a.TelefonoApoderado
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Sin contacto</span>
                                }
                            </td>
                            <td>@(a.FechaIngreso.HasValue ? a.FechaIngreso.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person-badge text-primary me-1"></i> @a.NombreProfesor
                                </span>
                            </td>
                            <td>
                                <span class="badge @(a.ActivoAlumno ? "bg-success" : "bg-secondary")">
                                    @(a.ActivoAlumno ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@a.IdAlumno" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
