@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Canchitas Club";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="text-success mb-2" style="font-size: 3rem;">
                <i class="bi bi-dribbble"></i>
            </div>
            <h3 class="fw-bold mb-1 text-dark">Canchitas Club</h3>
            <p class="text-muted" style="font-size: 0.9rem;">Portal de Administración Web</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2" role="alert" style="font-size: 0.85rem;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
            </div>
        }

        <form asp-controller="Login" asp-action="IniciarSesion" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold text-muted">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input type="text" name="username" class="form-control border-start-0 ps-0" placeholder="Ej: admin" required autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold text-muted">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input type="password" name="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                </div>
            </div>

            <button type="submit" class="btn btn-green">
                <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
            </button>
        </form>

        <div class="text-center mt-4">
            <small class="text-muted">Proyecto Móviles & Web API &copy; 2026</small>
        </div>
    </div>
</body>
</html>
