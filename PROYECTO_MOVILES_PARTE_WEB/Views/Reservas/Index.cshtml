@model List<PROYECTO_MOVILES_PARTE_WEB.Models.Reserva>
@{
    ViewData["Title"] = "Gestión de Alquileres";
    var canchas = ViewBag.Canchas as List<PROYECTO_MOVILES_PARTE_WEB.Models.Cancha> ?? new();
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar-check-fill text-success me-2"></i> Alquileres de Canchas</h3>
            <p class="text-muted mb-0">Control de reservas de clientes, horarios, cobros y saldos pendientes</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ReporteImprimible" target="_blank" class="btn btn-outline-danger">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Imprimir / Exportar PDF
            </a>
            <a asp-action="Crear" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Nueva Reserva
            </a>
        </div>
    </div>

    <!-- Tarjetas de resumen financiero -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card card-custom p-3 border-start border-4 border-success">
                <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">TOTAL RECAUDADO</div>
                <h3 class="fw-bold text-success mb-0">S/ @(((decimal)(ViewBag.TotalRecaudado ?? 0m)).ToString("N2"))</h3>
                <small class="text-muted">Cobrado en reservas activas</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3 border-start border-4 border-danger">
                <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">PENDIENTE POR COBRAR</div>
                <h3 class="fw-bold text-danger mb-0">S/ @(((decimal)(ViewBag.TotalPorCobrar ?? 0m)).ToString("N2"))</h3>
                <small class="text-muted">Saldos a pagar al momento del juego</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3 border-start border-4 border-primary">
                <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">RESERVAS LISTADAS</div>
                <h3 class="fw-bold text-dark mb-0">@Model.Count</h3>
                <small class="text-muted">Total de registros encontrados</small>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros -->
    <div class="card card-custom p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Completada" selected="@(ViewBag.EstadoSel == "Completada")">Completo</option>
                    <option value="Confirmada" selected="@(ViewBag.EstadoSel == "Confirmada")">Confirmado</option>
                    <option value="Pendiente" selected="@(ViewBag.EstadoSel == "Pendiente")">Pendiente</option>
                    <option value="Cancelada" selected="@(ViewBag.EstadoSel == "Cancelada")">Cancelada</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="idCancha" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Todas las Canchas --</option>
                    @foreach (var c in canchas)
                    {
                        <option value="@c.IdCancha" selected="@(ViewBag.IdCanchaSel == c.IdCancha)">@c.NombreCancha</option>
                    }
                </select>
            </div>
            <div class="col-md-4 text-end">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar Filtros</a>
            </div>
        </form>
    </div>

    <!-- Tabla de Reservas -->
    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Cancha</th>
                        <th>Fecha y Turno</th>
                        <th>Precio Total</th>
                        <th>Monto Recibido</th>
                        <th>Saldo Pendiente</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i> No se encontraron reservas registradas.
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model)
                    {
                        var saldo = Math.Max(0, r.PrecioReserva - r.MontoRecibido);
                        <tr>
                            <td class="fw-bold">@r.IdReserva</td>
                            <td>
                                <div class="fw-semibold">@r.NombreCliente</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@r.NombreCancha</span>
                            </td>
                            <td>
                                <div>@r.HoraInicio.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@r.HoraInicio.ToString("HH:mm") - @r.HoraFin.ToString("HH:mm")</small>
                            </td>
                            <td class="fw-bold">S/ @r.PrecioReserva.ToString("N2")</td>
                            <td class="text-success fw-bold">S/ @r.MontoRecibido.ToString("N2")</td>
                            <td>
                                @if (saldo > 0 && r.EstadoReserva != "Cancelada")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Debe S/ @saldo.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Pagado</span>
                                }
                            </td>
                            <td>
                                @if (r.EstadoReserva == "Completada" || (r.MontoRecibido >= r.PrecioReserva && r.EstadoReserva != "Cancelada"))
                                {
                                    <span class="badge bg-success"><i class="me-1"></i> Completo</span>
                                }
                                else if (r.EstadoReserva == "Confirmada" || (r.MontoRecibido > 0 && r.EstadoReserva != "Cancelada"))
                                {
                                    <span class="badge bg-primary"><i class="me-1"></i> Confirmado</span>
                                }
                                else if (r.EstadoReserva == "Cancelada")
                                {
                                    <span class="badge bg-danger"><i class="me-1"></i> Cancelada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="me-1"></i> Pendiente</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <a asp-action="Editar" asp-route-id="@r.IdReserva" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (r.EstadoReserva != "Cancelada")
                                    {
                                        <form asp-action="Cancelar" asp-route-id="@r.IdReserva" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas cancelar esta reserva?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancelar">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
