@model PROYECTO_MOVILES_PARTE_WEB.Models.Reserva
@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="container-fluid px-0" style="max-width: 800px;">
    <div class="card card-custom p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar-plus text-success me-2"></i> Registrar Alquiler</h4>
                <small class="text-muted">Crea una nueva reserva de cancha para un cliente</small>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <form asp-action="Crear" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cliente <span class="text-danger">*</span></label>
                    <select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select" required>
                        <option value="">-- Seleccione Cliente --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cancha <span class="text-danger">*</span></label>
                    <select asp-for="IdCancha" id="selectCancha" class="form-select" required>
                        <option value="" data-precio="0">-- Seleccione Cancha --</option>
                        @if (ViewBag.ListaCanchas != null)
                        {
                            foreach (var c in (List<PROYECTO_MOVILES_PARTE_WEB.Models.Cancha>)ViewBag.ListaCanchas)
                            {
                                <option value="@c.IdCancha" data-precio="@c.PrecioAlquiler" selected="@(c.IdCancha == Model.IdCancha)">
                                    @c.NombreCancha (S/ @c.PrecioAlquiler.ToString("F2")/hora)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Hora Inicio <span class="text-danger">*</span></label>
                    <input asp-for="HoraInicio" id="inputInicio" type="datetime-local" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Hora Fin <span class="text-danger">*</span></label>
                    <input asp-for="HoraFin" id="inputFin" type="datetime-local" class="form-control" required />
                </div>

                <!-- Detalle de Duración y Tarifa -->
                <div class="col-12" id="boxDetalleTiempo" style="display: none;">
                    <div class="alert alert-light border d-flex align-items-center justify-content-between p-2 mb-0">
                        <div>
                            <i class="bi bi-clock-history text-primary me-2"></i>
                            <span class="fw-semibold">Duración calculada:</span> <span id="txtDuracion" class="badge bg-primary fs-6">1 hora</span>
                            <span id="badgeAvisoMinimo" class="badge bg-warning text-dark ms-2" style="display: none;">
                                <i class="bi bi-info-circle me-1"></i> Mínimo sugerido de alquiler: 1 hora
                            </span>
                        </div>
                        <div>
                            <span class="text-muted small">Tarifa de cancha: </span><strong id="txtTarifaCancha" class="text-dark">S/ 0.00</strong>/hora
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Precio Total (S/) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">S/</span>
                        <input asp-for="PrecioReserva" id="inputPrecioTotal" type="number" step="0.5" class="form-control fw-bold text-success fs-5 bg-light" placeholder="0.00" readonly required />
                    </div>
                    <small class="text-muted"><i class="bi bi-lock-fill me-1"></i>Bloqueado (calculado por horas)</small>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Monto Recibido (S/) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">S/</span>
                        <input asp-for="MontoRecibido" id="inputMontoRecibido" type="number" step="0.5" min="0" class="form-control fw-bold fs-5" placeholder="0.00" required />
                    </div>
                    <small class="text-muted">Adelanto o pago completo (mínimo S/ 0)</small>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Estado de la Reserva</label>
                    <select asp-for="EstadoReserva" class="form-select">
                        <option value="Confirmada">Confirmada</option>
                        <option value="Pendiente">Pendiente</option>
                    </select>
                </div>

                <!-- Resumen de Saldo Dinámico -->
                <div class="col-12" id="boxSaldo" style="display: none;">
                    <div id="alertSaldo" class="alert alert-info py-2 px-3 mb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-wallet2 me-2"></i>
                            <strong id="lblSaldoTitulo">Saldo por Cobrar:</strong>
                            <span id="lblSaldoMonto" class="fs-6 fw-bold ms-1">S/ 0.00</span>
                        </div>
                        <span id="badgeEstadoPago" class="badge bg-success py-2 px-3">Pagado completo</span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i> Guardar Reserva
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const selectCancha = document.getElementById('selectCancha');
        const inputInicio = document.getElementById('inputInicio');
        const inputFin = document.getElementById('inputFin');
        const inputPrecioTotal = document.getElementById('inputPrecioTotal');
        const inputMontoRecibido = document.getElementById('inputMontoRecibido');
        const boxDetalleTiempo = document.getElementById('boxDetalleTiempo');
        const txtDuracion = document.getElementById('txtDuracion');
        const txtTarifaCancha = document.getElementById('txtTarifaCancha');
        const badgeAvisoMinimo = document.getElementById('badgeAvisoMinimo');
        const boxSaldo = document.getElementById('boxSaldo');
        const lblSaldoTitulo = document.getElementById('lblSaldoTitulo');
        const lblSaldoMonto = document.getElementById('lblSaldoMonto');
        const alertSaldo = document.getElementById('alertSaldo');
        const badgeEstadoPago = document.getElementById('badgeEstadoPago');

        function calcularPrecioYSaldo() {
            const opt = selectCancha.options[selectCancha.selectedIndex];
            const tarifaHora = parseFloat(opt?.getAttribute('data-precio') || 0);

            const dtInicio = new Date(inputInicio.value);
            const dtFin = new Date(inputFin.value);

            if (!isNaN(dtInicio.getTime()) && !isNaN(dtFin.getTime()) && dtFin > dtInicio && tarifaHora > 0) {
                const diffMs = dtFin - dtInicio;
                const horasExactas = diffMs / (1000 * 60 * 60);

                const horasEnteras = Math.floor(horasExactas);
                const minutosRestantes = Math.round((horasExactas - horasEnteras) * 60);
                let duracionTexto = "";
                if (horasEnteras > 0) duracionTexto += `${horasEnteras} h `;
                if (minutosRestantes > 0) duracionTexto += `${minutosRestantes} min`;
                if (duracionTexto === "") duracionTexto = "0 min";

                txtDuracion.textContent = duracionTexto;
                txtTarifaCancha.textContent = `S/ ${tarifaHora.toFixed(2)}`;
                boxDetalleTiempo.style.display = 'block';

                if (horasExactas < 1) {
                    badgeAvisoMinimo.style.display = 'inline-block';
                } else {
                    badgeAvisoMinimo.style.display = 'none';
                }

                // Cálculo proporcional exacto (ej. 1.5 horas * S/ 50 = S/ 75.00)
                const total = Math.round((horasExactas * tarifaHora) * 100) / 100;
                inputPrecioTotal.value = total.toFixed(2);
            } else {
                boxDetalleTiempo.style.display = 'none';
            }

            actualizarSaldo();
        }

        function actualizarSaldo() {
            const total = parseFloat(inputPrecioTotal.value) || 0;
            let recibido = parseFloat(inputMontoRecibido.value) || 0;
            if (recibido < 0) {
                recibido = 0;
                inputMontoRecibido.value = 0;
            }
            const saldo = Math.round((total - recibido) * 100) / 100;

            if (total > 0) {
                boxSaldo.style.display = 'block';
                if (saldo <= 0) {
                    alertSaldo.className = "alert alert-success py-2 px-3 mb-0 d-flex justify-content-between align-items-center";
                    lblSaldoTitulo.textContent = "Estado:";
                    lblSaldoMonto.textContent = `Pagado totalmente (S/ ${recibido.toFixed(2)})`;
                    badgeEstadoPago.className = "badge bg-success py-2 px-3";
                    badgeEstadoPago.textContent = "✓ Completamente Pagado";
                } else {
                    alertSaldo.className = "alert alert-warning py-2 px-3 mb-0 d-flex justify-content-between align-items-center";
                    lblSaldoTitulo.textContent = "Saldo Pendiente:";
                    lblSaldoMonto.textContent = `S/ ${saldo.toFixed(2)}`;
                    badgeEstadoPago.className = "badge bg-danger py-2 px-3";
                    badgeEstadoPago.textContent = `⚠️ Debe S/ ${saldo.toFixed(2)} al jugar`;
                }
            } else {
                boxSaldo.style.display = 'none';
            }
        }

        selectCancha.addEventListener('change', calcularPrecioYSaldo);
        inputInicio.addEventListener('change', calcularPrecioYSaldo);
        inputFin.addEventListener('change', calcularPrecioYSaldo);
        inputPrecioTotal.addEventListener('input', actualizarSaldo);
        inputMontoRecibido.addEventListener('input', actualizarSaldo);

        // Inicializar cálculo al cargar la página
        calcularPrecioYSaldo();
    </script>
}
