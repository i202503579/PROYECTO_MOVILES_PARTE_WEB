@model PROYECTO_MOVILES_PARTE_WEB.Models.Reserva
@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="container-fluid px-0" style="max-width: 800px;">
    <div class="card card-custom p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar-plus text-success me-2"></i> Registrar Alquiler</h4>
                <small class="text-muted">Crea una nueva reserva de cancha para un cliente</small>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <form asp-action="Crear" method="post">
            <input type="hidden" asp-for="HoraFin" id="inputFin" />
            <input type="hidden" asp-for="EstadoReserva" id="inputEstadoReserva" value="Pendiente" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cliente <span class="text-danger">*</span></label>
                    <select asp-for="IdCliente" asp-items="ViewBag.Clientes" class="form-select" required>
                        <option value="">-- Seleccione Cliente --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Cancha <span class="text-danger">*</span></label>
                    <select asp-for="IdCancha" id="selectCancha" class="form-select" required>
                        <option value="" data-precio="0">-- Seleccione Cancha --</option>
                        @if (ViewBag.ListaCanchas != null)
                        {
                            foreach (var c in (List<PROYECTO_MOVILES_PARTE_WEB.Models.Cancha>)ViewBag.ListaCanchas)
                            {
                                <option value="@c.IdCancha" data-precio="@c.PrecioAlquiler" selected="@(c.IdCancha == Model.IdCancha)">
                                    @c.NombreCancha (S/ @c.PrecioAlquiler.ToString("F2")/hora)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Hora de Inicio <span class="text-danger">*</span></label>
                    <input asp-for="HoraInicio" id="inputInicio" type="datetime-local" class="form-control" required />
                    <small class="text-muted d-block mt-1">Hora de inicio del partido</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Duración del Alquiler <span class="text-danger">*</span></label>
                    <div class="d-flex gap-2">
                        <input type="radio" class="btn-check" name="duracionOpcion" id="btn1Hora" value="1" checked autocomplete="off" onchange="seleccionarDuracion(1)">
                        <label class="btn btn-outline-success flex-fill py-2 fw-semibold" for="btn1Hora">
                            <i class="bi bi-clock me-1"></i> 1 Hora
                        </label>

                        <input type="radio" class="btn-check" name="duracionOpcion" id="btn2Horas" value="2" autocomplete="off" onchange="seleccionarDuracion(2)">
                        <label class="btn btn-outline-success flex-fill py-2 fw-semibold" for="btn2Horas">
                            <i class="bi bi-clock-history me-1"></i> 2 Horas
                        </label>
                    </div>
                    <small class="text-muted d-block mt-1">
                        Hora fin calculada: <strong id="lblHoraFinTexto" class="text-dark">--:--</strong>
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Precio Total (S/)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">S/</span>
                        <input asp-for="PrecioReserva" id="inputPrecioTotal" type="number" step="0.5" class="form-control fw-bold text-success fs-5 bg-light" placeholder="0.00" readonly required />
                    </div>
                    <small class="text-muted"><i class="bi bi-lock-fill me-1"></i>Calculado automáticamente según cancha y horas</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Monto Recibido (S/) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">S/</span>
                        <input asp-for="MontoRecibido" id="inputMontoRecibido" type="number" step="0.5" min="0" class="form-control fw-bold fs-5" placeholder="0.00" required />
                    </div>
                    <small class="text-muted">Adelanto o pago total del alquiler</small>
                </div>

                <div class="col-12" id="boxEstadoPago">
                    <div id="alertEstadoPago" class="alert alert-warning py-2 px-3 mb-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold me-1">Estado de la Reserva:</span>
                            <span id="badgeEstadoVisual" class="badge bg-warning text-dark py-1 px-2 fs-6">Pendiente</span>
                        </div>
                        <div>
                            <span id="lblDetalleSaldo" class="small fw-semibold">Pendiente de pago: S/ 0.00</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i> Guardar Reserva
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const selectCancha = document.getElementById('selectCancha');
        const inputInicio = document.getElementById('inputInicio');
        const inputFin = document.getElementById('inputFin');
        const inputPrecioTotal = document.getElementById('inputPrecioTotal');
        const inputMontoRecibido = document.getElementById('inputMontoRecibido');
        const inputEstadoReserva = document.getElementById('inputEstadoReserva');
        const lblHoraFinTexto = document.getElementById('lblHoraFinTexto');
        const alertEstadoPago = document.getElementById('alertEstadoPago');
        const badgeEstadoVisual = document.getElementById('badgeEstadoVisual');
        const lblDetalleSaldo = document.getElementById('lblDetalleSaldo');

        let duracionSeleccionada = 1;

        function seleccionarDuracion(horas) {
            duracionSeleccionada = horas;
            calcularTodo();
        }

        function calcularTodo() {
            const opt = selectCancha.options[selectCancha.selectedIndex];
            const tarifaHora = parseFloat(opt?.getAttribute('data-precio') || 0);

            if (inputInicio.value) {
                const dtInicio = new Date(inputInicio.value);
                if (!isNaN(dtInicio.getTime())) {
                    const dtFin = new Date(dtInicio.getTime() + (duracionSeleccionada * 60 * 60 * 1000));
                    
                    const anio = dtFin.getFullYear();
                    const mes = String(dtFin.getMonth() + 1).padStart(2, '0');
                    const dia = String(dtFin.getDate()).padStart(2, '0');
                    const hora = String(dtFin.getHours()).padStart(2, '0');
                    const min = String(dtFin.getMinutes()).padStart(2, '0');
                    
                    inputFin.value = `${anio}-${mes}-${dia}T${hora}:${min}`;
                    lblHoraFinTexto.textContent = `${dia}/${mes}/${anio} ${hora}:${min}`;
                }
            }

            const total = Math.round((tarifaHora * duracionSeleccionada) * 100) / 100;
            inputPrecioTotal.value = total.toFixed(2);
            inputMontoRecibido.max = total.toFixed(2);

            actualizarEstadoPago();
        }

        function actualizarEstadoPago() {
            const total = parseFloat(inputPrecioTotal.value) || 0;
            let recibido = parseFloat(inputMontoRecibido.value) || 0;

            if (recibido < 0) {
                recibido = 0;
                inputMontoRecibido.value = 0;
            }

            if (total > 0 && recibido > total) {
                recibido = total;
                inputMontoRecibido.value = total.toFixed(2);
            }

            const saldo = Math.round((total - recibido) * 100) / 100;

            if (total > 0 && recibido >= total) {
                inputEstadoReserva.value = "Completada";
                alertEstadoPago.className = "alert alert-success py-2 px-3 mb-0 d-flex justify-content-between align-items-center";
                badgeEstadoVisual.className = "badge bg-success py-1 px-2 fs-6";
                badgeEstadoVisual.textContent = "Completo";
                lblDetalleSaldo.textContent = `Pagado totalmente (S/ ${recibido.toFixed(2)})`;
            } else if (recibido > 0) {
                inputEstadoReserva.value = "Confirmada";
                alertEstadoPago.className = "alert alert-primary py-2 px-3 mb-0 d-flex justify-content-between align-items-center";
                badgeEstadoVisual.className = "badge bg-primary py-1 px-2 fs-6";
                badgeEstadoVisual.textContent = "Confirmado";
                lblDetalleSaldo.textContent = `Adelanto recibido: S/ ${recibido.toFixed(2)} (Resta S/ ${saldo.toFixed(2)})`;
            } else {
                inputEstadoReserva.value = "Pendiente";
                alertEstadoPago.className = "alert alert-warning py-2 px-3 mb-0 d-flex justify-content-between align-items-center";
                badgeEstadoVisual.className = "badge bg-warning text-dark py-1 px-2 fs-6";
                badgeEstadoVisual.textContent = "Pendiente";
                lblDetalleSaldo.textContent = `Pendiente por cobrar: S/ ${saldo.toFixed(2)}`;
            }
        }

        selectCancha.addEventListener('change', calcularTodo);
        inputInicio.addEventListener('change', calcularTodo);
        inputMontoRecibido.addEventListener('input', actualizarEstadoPago);

        calcularTodo();
    </script>
}
