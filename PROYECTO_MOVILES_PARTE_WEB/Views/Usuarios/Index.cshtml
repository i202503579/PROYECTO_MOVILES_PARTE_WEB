@model List<PROYECTO_MOVILES_PARTE_WEB.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-shield-lock-fill text-success me-2"></i> Usuarios y Roles</h3>
            <p class="text-muted mb-0">Cuentas de acceso para Administradores, Operadores de Cancha y Profesores</p>
        </div>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
        </a>
    </div>

    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nombre Completo</th>
                        <th>Username</th>
                        <th>Teléfono</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No se encontraron usuarios.
                            </td>
                        </tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@u.IdUsuario</td>
                            <td class="fw-semibold">@u.NombreUsuario</td>
                            <td><code>@u.UsernameUsuario</code></td>
                            <td>@u.Telefono</td>
                            <td>
                                @if (u.Rol == "Administrador")
                                {
                                    <span class="badge bg-danger">Administrador</span>
                                }
                                else if (u.Rol == "Operador")
                                {
                                    <span class="badge bg-primary">Operador</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Profesor</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(u.ActivoUsuario ? "bg-success" : "bg-secondary")">
                                    @(u.ActivoUsuario ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <a asp-action="Editar" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="CambiarEstado" asp-route-id="@u.IdUsuario" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(u.ActivoUsuario ? "btn-outline-danger" : "btn-outline-success")" title="@(u.ActivoUsuario ? "Desactivar" : "Activar")">
                                            <i class="bi @(u.ActivoUsuario ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Paginador" />
    </div>
</div>
