@model List<PROYECTO_MOVILES_PARTE_WEB.Models.Cancha>
@{
    ViewData["Title"] = "Gestión de Canchitas";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-layers-fill text-success me-2"></i> Canchitas Deportivas</h3>
            <p class="text-muted mb-0">Configuración de campos de juego, tipos de superficie y tarifas por hora</p>
        </div>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Nueva Cancha
        </a>
    </div>

    <div class="row g-3">
        @if (Model.Count == 0)
        {
            <div class="col-12">
                <div class="card card-custom p-5 text-center text-muted">
                    <i class="bi bi-dribbble fs-1 mb-2 text-muted"></i>
                    No hay canchas registradas en el sistema.
                </div>
            </div>
        }
        @foreach (var c in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom h-100 p-4 border-top border-4 @(c.ActivoCancha ? "border-success" : "border-secondary")">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="bi bi-dribbble fs-3"></i>
                        </div>
                        @if (c.ActivoCancha)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </div>

                    <h4 class="fw-bold mb-1 text-dark">@c.NombreCancha</h4>
                    <p class="text-muted mb-3" style="font-size: 0.9rem;">@c.DescripcionCancha</p>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                        <div>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">TARIFA DE ALQUILER</small>
                            <span class="fw-bold text-success fs-5">S/ @c.PrecioAlquiler.ToString("N2")</span>
                            <small class="text-muted">/ hora</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a asp-action="Editar" asp-route-id="@c.IdCancha" class="btn btn-sm btn-outline-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="CambiarEstado" asp-route-id="@c.IdCancha" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(c.ActivoCancha ? "btn-outline-danger" : "btn-outline-success")" title="@(c.ActivoCancha ? "Desactivar" : "Activar")">
                                    <i class="bi @(c.ActivoCancha ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
