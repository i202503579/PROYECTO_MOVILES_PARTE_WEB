@model PROYECTO_MOVILES_PARTE_WEB.Models.Cliente
@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container-fluid px-0" style="max-width: 700px;">
    <div class="card card-custom p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i> Modificar Cliente</h4>
                <small class="text-muted">Editar datos personales o de contacto</small>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver</a>
        </div>

        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="IdCliente" />

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Nombre Completo / Empresa <span class="text-danger">*</span></label>
                    <input asp-for="NombreCliente" class="form-control" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\s\.\-]+" title="Solo se permiten letras y espacios" oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s\.\-]/g, '')" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Tipo de Cliente <span class="text-danger">*</span></label>
                    <select asp-for="TipoCliente" class="form-select">
                        <option value="Particular">Particular</option>
                        <option value="Institucional">Institucional</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Número de Documento (DNI/RUC) <span class="text-danger">*</span></label>
                    <input asp-for="NumeroDocumento" class="form-control" maxlength="11" minlength="8" pattern="[0-9]{8,11}" title="Debe ingresar entre 8 y 11 dígitos numéricos" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Teléfono / Celular</label>
                    <input asp-for="TelefonoCliente" class="form-control" maxlength="9" pattern="9[0-9]{8}" title="Debe tener 9 dígitos y comenzar con 9" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                </div>

                <div class="col-md-6 d-flex align-items-center mt-4">
                    <div class="form-check form-switch fs-5">
                        <input asp-for="ActivoCliente" class="form-check-input" type="checkbox" />
                        <label class="form-check-label fs-6 fw-semibold text-muted ms-2">Cliente Activo</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>
