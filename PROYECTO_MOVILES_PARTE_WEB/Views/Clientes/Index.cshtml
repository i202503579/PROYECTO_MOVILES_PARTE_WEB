@model List<PROYECTO_MOVILES_PARTE_WEB.Models.Cliente>
@{
    ViewData["Title"] = "Directorio de Clientes";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-person-lines-fill text-success me-2"></i> Directorio de Clientes</h3>
            <p class="text-muted mb-0">Clientes particulares e instituciones registradas para reservas</p>
        </div>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Cliente
        </a>
    </div>

    <div class="card card-custom p-3 mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre o número de documento..." />
                </div>
            </div>
            <div class="col-md-6 text-end">
                <button type="submit" class="btn btn-primary">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>

    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nombre / Razón Social</th>
                        <th>Documento (DNI/RUC)</th>
                        <th>Tipo</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No se encontraron clientes.
                            </td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@c.IdCliente</td>
                            <td class="fw-semibold">@c.NombreCliente</td>
                            <td><code>@c.NumeroDocumento</code></td>
                            <td>
                                <span class="badge @(c.TipoCliente == "Institucional" ? "bg-primary" : "bg-info text-dark")">
                                    @c.TipoCliente
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(c.TelefonoCliente))
                                {
                                    <a href="tel:@c.TelefonoCliente" class="text-decoration-none text-dark">
                                        <i class="bi bi-telephone me-1 text-success"></i> @c.TelefonoCliente
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Sin teléfono</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(c.ActivoCliente ? "bg-success" : "bg-secondary")">
                                    @(c.ActivoCliente ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@c.IdCliente" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Paginador" />
    </div>
</div>
