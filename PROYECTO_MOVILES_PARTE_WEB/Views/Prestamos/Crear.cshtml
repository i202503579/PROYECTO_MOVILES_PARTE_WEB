@model PROYECTO_MOVILES_PARTE_WEB.Models.PrestamoBalon
@{
    ViewData["Title"] = "Prestar Balón";
}

<div class="container-fluid px-0" style="max-width: 650px;">
    <div class="card card-custom p-4">
        <!-- Encabezado con div cerrado correctamente -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-trophy-fill text-success me-2"></i> Prestar Balón</h4>
                <small class="text-muted">Registro de salida de material deportivo</small>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <form asp-action="Crear" method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Clase de Academia (Profesor a cargo) <span class="text-danger">*</span></label>
                    <select asp-for="IdClase" asp-items="ViewBag.Clases" class="form-select form-select-lg fs-6" required>
                        <option value="">-- Seleccionar Clase de Academia --</option>
                    </select>
                    <small class="text-muted">El material se entrega al profesor para la sesión de entrenamiento</small>
                </div>

                <div class="col-12">
                    <div class="border rounded p-3 bg-light">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="chkInstitucional" onchange="toggleInstitucional(this.checked)">
                            <label class="form-check-label fw-semibold" for="chkInstitucional">
                                ¿Es para un alquiler Institucional? (Colegio / Empresa)
                            </label>
                        </div>
                        <div id="boxReservaInstitucional" style="display: none;">
                            <label class="form-label small text-muted">Seleccionar Reserva Institucional:</label>
                            <select asp-for="IdReserva" id="selectReserva" asp-items="ViewBag.Reservas" class="form-select">
                                <option value="">-- Ninguna --</option>
                            </select>
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                <i class="bi bi-info-circle me-1"></i> Según la regla RN06, solo las instituciones tienen balones incluidos.
                            </small>
                        </div>
                    </div>
                </div>

                <input type="hidden" asp-for="EstadoPrestamo" value="Pendiente" />

                <div class="col-12">
                    <label class="form-label fw-semibold">Fecha y Hora de Entrega <span class="text-danger">*</span></label>
                    <input asp-for="FechaEntrega" type="datetime-local" class="form-control" value="@Model.FechaEntrega.ToString("yyyy-MM-ddTHH:mm")" step="60" required />
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <small class="text-muted">Hora de salida del material</small>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i> Registrar Préstamo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleInstitucional(activo) {
            const box = document.getElementById('boxReservaInstitucional');
            const selectReserva = document.getElementById('selectReserva');
            const selectClase = document.getElementById('IdClase');

            if (activo) {
                box.style.display = 'block';
                selectClase.removeAttribute('required');
            } else {
                box.style.display = 'none';
                selectReserva.value = "";
                selectClase.setAttribute('required', 'required');
            }
        }
    </script>
}
