@model PROYECTO_MOVILES_PARTE_WEB.Models.PrestamoBalon
@{
    ViewData["Title"] = "Editar Préstamo de Balón";
}

<div class="container-fluid px-0" style="max-width: 650px;">
    <div class="card card-custom p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-pencil-square text-success me-2"></i> Editar Préstamo #@Model.IdPrestamo</h4>
                <small class="text-muted">Modificar destino, fechas o estado del material deportivo</small>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="IdPrestamo" />

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Clase de Academia (Profesor a cargo)</label>
                    <select asp-for="IdClase" asp-items="ViewBag.Clases" class="form-select">
                        <option value="">-- Sin clase (o es Alquiler Institucional) --</option>
                    </select>
                </div>

                <div class="col-12">
                    <div class="border rounded p-3 bg-light">
                        <label class="form-label fw-semibold mb-1">Reserva Institucional (Colegio / Empresa)</label>
                        <select asp-for="IdReserva" asp-items="ViewBag.Reservas" class="form-select">
                            <option value="">-- Sin reserva institucional --</option>
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1"></i> Según RN06, solo aplica a instituciones o clases de academia.
                        </small>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Fecha y Hora de Entrega <span class="text-danger">*</span></label>
                    <input asp-for="FechaEntrega" type="datetime-local" class="form-control" value="@Model.FechaEntrega.ToString("yyyy-MM-ddTHH:mm")" required />
                    <small class="text-muted">Momento de salida del balón</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Fecha y Hora de Devolución</label>
                    <input asp-for="FechaDevolucion" type="datetime-local" class="form-control" 
                           value="@(Model.FechaDevolucion.HasValue ? Model.FechaDevolucion.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    <small class="text-muted">Requerido si ya fue devuelto o cerrado</small>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Estado del Préstamo <span class="text-danger">*</span></label>
                    <select asp-for="EstadoPrestamo" class="form-select form-select-lg fs-6" required>
                        <option value="Pendiente">Pendiente (En juego / uso)</option>
                        <option value="Devuelto">Devuelto (En buen estado)</option>
                        <option value="Dañado">Dañado (Pinchado / rajado / deteriorado)</option>
                        <option value="Perdido">Perdido (Extraviado / no devuelto)</option>
                    </select>
                    <small class="text-muted">Permite controlar bajas de inventario por daños o pérdidas</small>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-save me-1"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>
