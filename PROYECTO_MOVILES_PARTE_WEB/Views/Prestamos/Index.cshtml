@model List<PROYECTO_MOVILES_PARTE_WEB.Models.PrestamoBalon>
@{
    ViewData["Title"] = "Préstamo de Balones";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-trophy-fill text-success me-2"></i> Préstamo de Balones</h3>
            <p class="text-muted mb-0">Control de material deportivo prestado a reservas institucionales o clases</p>
        </div>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Prestar Balón
        </a>
    </div>

    <div class="card card-custom p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Destino</th>
                        <th>Fecha de Entrega</th>
                        <th>Fecha de Devolución</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No hay préstamos de balones registrados.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@p.IdPrestamo</td>
                            <td>
                                @if (p.IdReserva.HasValue)
                                {
                                    <span class="badge bg-primary">Reserva #@p.IdReserva</span>
                                }
                                else if (p.IdClase.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">Clase #@p.IdClase</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@p.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(p.FechaDevolucion.HasValue ? p.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td>
                                @if (p.EstadoPrestamo == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Pendiente</span>
                                }
                                else if (p.EstadoPrestamo == "Devuelto")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Devuelto</span>
                                }
                                else if (p.EstadoPrestamo == "Dañado")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Dañado</span>
                                }
                                else if (p.EstadoPrestamo == "Perdido")
                                {
                                    <span class="badge bg-dark"><i class="bi bi-x-octagon me-1"></i> Perdido</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@p.EstadoPrestamo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    @if (p.EstadoPrestamo == "Pendiente")
                                    {
                                        <div class="dropdown d-inline">
                                            <button class="btn btn-sm btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-check2-circle me-1"></i> Finalizar
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <form asp-action="CambiarEstado" method="post" class="dropdown-item p-0">
                                                        <input type="hidden" name="id" value="@p.IdPrestamo" />
                                                        <input type="hidden" name="nuevoEstado" value="Devuelto" />
                                                        <button type="submit" class="btn btn-link dropdown-item text-success py-2">
                                                            <i class="bi bi-check-circle me-2"></i> Marcar Devuelto
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <form asp-action="CambiarEstado" method="post" class="dropdown-item p-0">
                                                        <input type="hidden" name="id" value="@p.IdPrestamo" />
                                                        <input type="hidden" name="nuevoEstado" value="Dañado" />
                                                        <button type="submit" class="btn btn-link dropdown-item text-danger py-2" onclick="return confirm('¿Registrar este balón como DAÑADO?');">
                                                            <i class="bi bi-exclamation-triangle me-2"></i> Marcar Dañado
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="CambiarEstado" method="post" class="dropdown-item p-0">
                                                        <input type="hidden" name="id" value="@p.IdPrestamo" />
                                                        <input type="hidden" name="nuevoEstado" value="Perdido" />
                                                        <button type="submit" class="btn btn-link dropdown-item text-dark py-2" onclick="return confirm('¿Registrar este balón como PERDIDO?');">
                                                            <i class="bi bi-x-octagon me-2"></i> Marcar Perdido
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    }

                                    <a asp-action="Editar" asp-route-id="@p.IdPrestamo" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form asp-action="Eliminar" asp-route-id="@p.IdPrestamo" method="post" class="d-inline mb-0" onsubmit="return confirm('¿Seguro que deseas eliminar este registro de préstamo?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar registro">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Paginador" />
    </div>
</div>
